# Backend
APP_NAME=codedive
FRONTEND_ORIGIN=http://localhost:5173
STORAGE_DIR=storage
CHROMA_DIR=storage/chroma
REPOS_DIR=storage/repos

# Repository ingestion
MAX_FILE_SIZE_BYTES=512000
MAX_FILES=1000
MAX_CHUNKS=5000
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
CLONE_TIMEOUT_SECONDS=120

# Retrieval
TOP_K=5
MAX_CONTEXT_CHARS=12000
MAX_ANSWER_TOKENS=700

# AI providers:
# - local: deterministic local embeddings (no downloads, offline)
# - ollama: use a locally hosted Ollama server
# - gemini: use the Gemini API via its OpenAI-compatible endpoint (requires GEMINI_API_KEY)
# - auto: use Gemini when GEMINI_API_KEY is set, otherwise use Ollama
# - openai: require OPENAI_API_KEY
EMBEDDING_PROVIDER=local
LLM_PROVIDER=ollama

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:latest
OLLAMA_LLM_MODEL=qwen2.5-coder:7b-instruct
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE=5m

# Gemini (set your real GEMINI_API_KEY in .env, which is gitignored)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_LLM_MODEL=gemini-3.5-flash-lite

# OpenAI
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-5.6

# Local fallback embeddings
LOCAL_EMBEDDING_DIMENSIONS=384
